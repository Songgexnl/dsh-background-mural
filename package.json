{
  "name": "dsh-background-mural",
  "version": "0.1.14",
  "private": false,
  "description": "Mural — upload your own image or video and use it as the DSH GUI background, on both the desktop app and the web GUI.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.1.1-rc.1 <0.3.0-0"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ],
      "platform": "web"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "INSTALL.zh.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "background",
    "wallpaper",
    "video-background"
  ],
  "license": "MIT",
  "scripts": {
    "test": "node --test test/"
  }
}
